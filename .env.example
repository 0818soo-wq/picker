# Supabase 프로젝트 설정 > API 에서 확인할 수 있습니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 추첨 페이지(/draw) 접근용 비밀번호 (자유롭게 지정)
ADMIN_PASSCODE=change-me

# 관리자 로그인 세션 서명용 임의의 긴 문자열 (예: openssl rand -hex 32)
ADMIN_SESSION_SECRET=change-me-too

# 타입캐스트(typecast.ai) API 키와, 당첨자 발표에 사용할 목소리(사장님)의 voice_id
# voice_id를 모르면 배포 후 /api/admin/typecast-voices 에 로그인 상태로 접속해 목록에서 확인하세요.
TYPECAST_API_KEY=your-typecast-api-key
TYPECAST_VOICE_ID=your-typecast-voice-id

# (선택) 접수 목록에서 "주제와 무관한 내용"을 AI로 판별해 표시하는 기능에 사용합니다.
# 설정하지 않으면 이 기능만 비활성화되고 나머지 의심 접수 표시는 그대로 동작합니다.
ANTHROPIC_API_KEY=your-anthropic-api-key
